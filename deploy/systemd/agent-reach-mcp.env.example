# Private/local deployment intended to sit behind Secure MCP Tunnel.
AGENT_REACH_MCP_TRANSPORT=streamable-http
AGENT_REACH_MCP_AUTH_MODE=none
AGENT_REACH_MCP_HOST=127.0.0.1
AGENT_REACH_MCP_PORT=8080
AGENT_REACH_MCP_ALLOW_INSECURE_REMOTE=false

# Optional operational limits.
AGENT_REACH_MCP_REQUEST_TIMEOUT_SECONDS=30
AGENT_REACH_MCP_MAX_OUTPUT_BYTES=5242880
AGENT_REACH_MCP_MAX_TEXT_CHARS=100000
AGENT_REACH_MCP_CAPABILITIES_CACHE_TTL_SECONDS=60

# X credentials, if enabled, should be supplied here or through Agent Reach's
# explicit configuration mechanism. Never commit their values.
# TWITTER_AUTH_TOKEN=
# TWITTER_CT0=
